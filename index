    const mu = d.murid;
    B.innerHTML = `<div class="ch"><div style="display:flex;gap:14px;align-items:center">${ph(mu.foto, mu.nama, 'pp')}<div><h3 style="font-size:17px">${esc(mu.nama)}</h3><div class="sub">${esc(mu.kelas)} · ${esc(mu.jantina || '')} · ${chip(mu.status, /aktif/i.test(mu.status) ? 'good' : 'warn')}</div></div></div><div class="sp"></div><button class="btn pri" id="pfCet">${ico('print')}Cetak rekod kokurikulum</button></div>${profilHTML(d)}`;
    hydrate(B);
    $$('[data-slip]', B).forEach(b => b.onclick = async () => { const r = await act(() => call('slipLihat', { id: b.dataset.slip })); const d2 = openModal(`<h2>Slip PAJSK</h2><div id="slLv">${loadingHTML}</div><div class="foot"><button class="btn" onclick="closeModal()">Tutup</button></div>`, true); await paparSlip(r, d2.querySelector('#slLv')); });
