  $('#pfQ').oninput = e => { f.q = e.target.value; drawL(); }; $('#pfS').onchange = e => { f.status = e.target.value; drawL(); }; $('#pfK').onchange = e => { f.kelas = e.target.value; drawL(); };
  const muat = async () => {
