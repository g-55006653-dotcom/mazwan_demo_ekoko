<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Demo e-Koko Pintar: sistem pengurusan kokurikulum sekolah dengan data rekaan.">
<title>Demo e-Koko Pintar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap">
<style>
/* Susun atur: skrin penuh — banner nipis boleh diubah suai, menu sisi boleh kuncup, kandungan grid 12 lajur */
:root{
  --bg:#eef2f8; --surface:#ffffff; --surface-2:#f5f7fb; --ink:#101a33; --ink-2:#47526d; --muted:#737d95; --line:#e2e7f0;
  --accent:#2f5bea; --accent-soft:#e8eefe; --navy:#14213d; --navy-ink:#f3f6ff; --navy-2:#24345c;
  --s1:#2a78d6; --s2:#eb6834;
  --good:#12875a; --good-soft:#e3f5ec; --warn:#a96b00; --warn-soft:#fdf2dc; --bad:#d13b3b; --bad-soft:#fde8e8;
  --t1:#e4f1e1; --t2:#cfe6c8; --t3:#b6d8ab;
  --shadow:0 1px 2px rgba(16,26,51,.05),0 4px 14px rgba(16,26,51,.05);
  --f-body:"Poppins",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,"SFMono-Regular",Menlo,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0c1222; --surface:#141c30; --surface-2:#1a2339; --ink:#eef1f8; --ink-2:#b4bdd2; --muted:#8f99b1; --line:#263150;
  --accent:#7d9bff; --accent-soft:#1d2a55; --navy:#0a1020; --navy-ink:#eef1f8; --navy-2:#1c2848;
  --s1:#3987e5; --s2:#d95926;
  --good:#3cc28a; --good-soft:#123426; --warn:#e3a33a; --warn-soft:#3a2b0c; --bad:#f07272; --bad-soft:#3c1717;
  --t1:#16301f; --t2:#1d3d27; --t3:#245030;
  --shadow:0 1px 2px rgba(0,0,0,.3); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0c1222; --surface:#141c30; --surface-2:#1a2339; --ink:#eef1f8; --ink-2:#b4bdd2; --muted:#8f99b1; --line:#263150;
  --accent:#7d9bff; --accent-soft:#1d2a55; --navy:#0a1020; --navy-ink:#eef1f8; --navy-2:#1c2848;
  --s1:#3987e5; --s2:#d95926;
  --good:#3cc28a; --good-soft:#123426; --warn:#e3a33a; --warn-soft:#3a2b0c; --bad:#f07272; --bad-soft:#3c1717;
  --t1:#16301f; --t2:#1d3d27; --t3:#245030;
  --shadow:0 1px 2px rgba(0,0,0,.3); color-scheme:dark}

html,body{height:100%}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:13.5px;overflow:hidden}
*{box-sizing:border-box}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
svg.i{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.num{font-variant-numeric:tabular-nums}
.app{height:100%;display:grid;grid-template-rows:auto auto 1fr;grid-template-columns:auto 1fr;grid-template-areas:"top top" "tick tick" "side main"}

/* Banner */
.top{grid-area:top;position:relative;isolation:isolate;background:var(--navy);color:var(--navy-ink);display:flex;align-items:center;gap:14px;overflow:hidden;
  padding-block:12px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.top::before{content:"";position:absolute;inset:0;z-index:-1;background-image:var(--banner,none);background-size:cover;background-position:center;opacity:var(--banner-op,.35)}
.top::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(10,16,32,.55),rgba(10,16,32,.15))}
.crest{width:46px;height:46px;border-radius:12px;background:linear-gradient(160deg,#ffd35a,#f0a500);display:grid;place-items:center;color:#14213d;font-weight:700;font-size:12px;flex:none;overflow:hidden}
.crest img{width:100%;height:100%;object-fit:contain;background:#fff}
.brand{min-width:0}
.brand b{display:block;font-size:18px;letter-spacing:.2px;text-shadow:0 1px 6px rgba(0,0,0,.35)}
.brand span{font-size:11.5px;opacity:.85;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.top .sp{flex:1}
.pill-dt{border:1px solid rgba(255,255,255,.28);background:rgba(10,16,32,.35);border-radius:999px;padding:5px 12px;font-size:12px;font-weight:600;white-space:nowrap}
.who{text-align:right;line-height:1.2}
.who b{font-size:13px;display:block}.who span{font-size:10.5px;letter-spacing:.8px;opacity:.75}
.ibtn{width:36px;height:36px;border-radius:10px;border:1px solid rgba(255,255,255,.25);background:rgba(36,52,92,.75);color:var(--navy-ink);display:grid;place-items:center;flex:none}
.ibtn:hover{background:var(--accent)}
.login-btn{border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.12);color:var(--navy-ink);border-radius:10px;padding:8px 14px;font-weight:600;display:flex;gap:8px;align-items:center;white-space:nowrap}
.login-btn:hover{background:var(--accent)}
.menu-btn{display:none}
.tick{grid-area:tick;display:flex;align-items:center;background:var(--surface);border-bottom:1px solid var(--line);overflow:hidden;min-width:0}
.tick .lbl{background:var(--bad);color:#fff;font-weight:700;font-size:11px;letter-spacing:.8px;padding:8px 14px;white-space:nowrap;padding-left:max(16px,env(safe-area-inset-left,0px))}
.tick .track{overflow:hidden;flex:1;min-width:0}
.tick .run{display:inline-flex;gap:34px;white-space:nowrap;animation:run 50s linear infinite;padding-left:20px;font-size:12.5px}
.tick .run em{font-style:normal;color:var(--accent);font-weight:600;margin-right:6px}
@keyframes run{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.tick .run{animation:none}}

/* Menu sisi */
.side{grid-area:side;width:250px;background:var(--surface);border-right:1px solid var(--line);overflow-y:auto;padding:10px 10px 24px;transition:width .2s;padding-left:max(10px,env(safe-area-inset-left,0px))}
.side .grp{font-size:10.5px;font-weight:700;letter-spacing:1.1px;text-transform:uppercase;color:var(--muted);padding:14px 10px 6px;white-space:nowrap;display:flex;align-items:center;gap:6px}
.side .grp svg{width:12px;height:12px}
.nav{display:flex;align-items:center;gap:11px;width:100%;border:0;background:none;padding:8px 10px;border-radius:9px;text-align:left;color:var(--ink-2);font-size:13px;white-space:nowrap}
.nav:hover{background:var(--surface-2);color:var(--ink)}
.nav svg.i{color:var(--ic,var(--muted))}
.nav.on{background:var(--surface);color:var(--accent);font-weight:600;box-shadow:0 0 0 1.5px var(--accent),0 6px 16px rgba(47,91,234,.18)}
.side .fold{display:flex;align-items:center;gap:8px;width:100%;border:0;background:none;font-size:10.5px;font-weight:700;letter-spacing:1.1px;text-transform:uppercase;color:var(--muted);padding:14px 10px 6px;text-align:left}
.side .fold:hover{color:var(--ink)}
.side .fold .chev{margin-left:auto;width:22px;height:22px;border-radius:7px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent);transition:transform .2s}
.side .fold .chev svg{width:14px;height:14px}
.side .fold.open .chev{transform:rotate(180deg)}
.side .sub-items{padding-left:6px;border-left:2px solid var(--line);margin-left:16px}
.app.mini .side .fold{font-size:0;padding:8px 0 4px;justify-content:center;border-top:1px solid var(--line);margin-top:6px}
.app.mini .side .fold .chev{display:none}
.app.mini .side .sub-items{padding:0;border:0;margin:0}
.app.mini .side{width:64px}
.app.mini .side .grp{font-size:0;padding:10px 0 4px;border-top:1px solid var(--line);margin:6px 8px 0}
.app.mini .side .grp svg{display:none}
.app.mini .nav span{display:none}
.app.mini .nav{justify-content:center}

.main{grid-area:main;overflow-y:auto;min-width:0;padding-block:18px 48px;padding-left:20px;padding-right:max(20px,env(safe-area-inset-right,0px))}
.ph{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.ph h1{font-size:21px;margin:0;line-height:1.2;text-wrap:balance}
.ph p{margin:3px 0 0;color:var(--muted);font-size:12.5px}
.ph .sp{flex:1}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}
.c2{grid-column:span 2}.c3{grid-column:span 3}.c4{grid-column:span 4}.c5{grid-column:span 5}.c6{grid-column:span 6}.c7{grid-column:span 7}.c8{grid-column:span 8}.c9{grid-column:span 9}.c12{grid-column:span 12}
@media (max-width:1380px){.c2{grid-column:span 4}.c3{grid-column:span 6}.c4,.c5{grid-column:span 6}.c7,.c8{grid-column:span 12}.c9{grid-column:span 8}}
@media (max-width:1100px){.c9,.c6{grid-column:span 12}}
@media (max-width:820px){.grid>*{grid-column:span 12!important}.grid>.c2{grid-column:span 6!important}}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:16px;min-width:0}
.card h3{margin:0;font-size:13.5px;font-weight:600}
.card .sub{font-size:11.5px;color:var(--muted);margin-top:2px}
.ch{display:flex;align-items:flex-start;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.ch .sp{flex:1}
.kpi{display:flex;flex-direction:column;gap:6px;padding:14px 16px}
.kpi .k{font-size:11px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:var(--muted)}
.kpi .v{font-size:26px;font-weight:700;line-height:1.1}
.kpi .d{font-size:11.5px;color:var(--ink-2)}
.legend{display:flex;gap:14px;font-size:11.5px;color:var(--ink-2);flex-wrap:wrap}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}
.chart{width:100%;position:relative}
.chart svg{display:block;width:100%;overflow:visible}
.chart text{fill:var(--muted);font-size:11px;font-family:var(--f-body)}
.chart .lab{fill:var(--ink);font-weight:600}
.chart .grid-l{stroke:var(--line);stroke-width:1}
.tip{position:fixed;z-index:80;pointer-events:none;background:var(--navy);color:var(--navy-ink);padding:7px 10px;border-radius:8px;font-size:12px;box-shadow:0 6px 20px rgba(0,0,0,.2);line-height:1.5}

.chip{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:3px 9px;border-radius:999px;white-space:nowrap;background:var(--surface-2);color:var(--ink-2)}
.chip.dot::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.chip.good,.st-Aktif,.st-Selesai,.st-Hadir,.st-Selesai{color:var(--good);background:var(--good-soft)}
.chip.warn,.st-Pindah,.st-Disahkan,.st-Ditempah,.st-Dalam{color:var(--warn);background:var(--warn-soft)}
.chip.bad,.st-Belum,.st-Baru,.st-Tidak{color:var(--bad);background:var(--bad-soft)}
.chip.acc,.st-Cadangan{color:var(--accent);background:var(--accent-soft)}
.st-Tamat{color:var(--muted);background:var(--surface-2)}
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse}
th{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap;background:var(--surface);vertical-align:bottom}
td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
td.nw,th.nw{white-space:nowrap}
.r{text-align:right}.c{text-align:center}
tr.click{cursor:pointer}tr.click:hover td{background:var(--surface-2)}
tfoot td{font-weight:700;background:var(--accent-soft)}
.mtag{display:inline-block;font-size:10px;font-weight:700;color:#c92a2a;background:#ffe3e3;border-radius:5px;padding:1px 5px;line-height:1.4;vertical-align:middle}.mtag.sm{font-size:9.5px;padding:0 4px}
.tkcal{border:1px solid var(--line);border-radius:12px;overflow:hidden}
.tkh{display:grid;grid-template-columns:52px repeat(7,1fr);background:var(--surface-2);font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;text-align:center}.tkh>div{padding:8px 0}
.tkw{display:grid;grid-template-columns:52px repeat(7,1fr);border-top:1px solid var(--line);min-height:96px;position:relative;column-gap:0}
.tkm{display:flex;justify-content:center;align-items:flex-start;padding-top:8px;border-right:1px solid var(--line);background:var(--surface-2)}
.tkd{border-left:1px solid var(--line);padding:4px 6px;font-size:12px;color:var(--ink-2);cursor:default;min-height:94px}.tkd:first-of-type{border-left:0}
.tkd b{font-weight:600}.tkd.luar{color:var(--muted);opacity:.55}.tkd.hujung{background:var(--surface-2)}.tkd.cuti{background:#fff0f1}.tkd.kini b{background:var(--accent);color:#fff;border-radius:999px;padding:1px 6px}
.tkbar{position:relative;z-index:1;margin:2px 3px 0;border:0;border-radius:6px;background:var(--c);color:#fff;font:600 11px/1.3 inherit;font-family:inherit;padding:3px 7px;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;align-self:start}.tkbar:hover{filter:brightness(1.08)}.tkbar.sambung{border-top-left-radius:0;border-bottom-left-radius:0}
.tkw>.tkbar{grid-row-start:auto}
.tkmx{border-collapse:separate;border-spacing:0;min-width:820px;table-layout:fixed;width:100%}.tkmx th:first-child,.tkmx td.tkt{width:110px}.tkmx th{text-align:center;background:var(--surface);position:sticky;top:0;z-index:1}.tkmx th:first-child{text-align:left}.tkmx .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px}
.tkmx td{border-bottom:1px solid var(--line);border-left:1px solid var(--line);vertical-align:top;padding:5px;height:38px}.tkmx td.tkt{border-left:0;white-space:nowrap;width:96px}.tkmx td.tkt small{display:block;font-size:9.5px;color:var(--muted);letter-spacing:.5px}
.tkmx tr.hujung td{background:var(--surface-2)}.tkmx tr.cuti td{background:#fff0f1}.tkmx tr.kini td.tkt{box-shadow:inset 3px 0 0 var(--accent)}
.tkc.tambah{cursor:cell}.tkc.tambah:hover{background:var(--accent-soft)}
.tkchip{display:block;width:100%;border:0;border-radius:6px;background:var(--c);color:#fff;font:600 11px/1.3 inherit;font-family:inherit;padding:4px 7px;text-align:left;margin-bottom:3px;cursor:pointer}.tkchip small{display:block;font-weight:400;opacity:.85;font-size:10px}
.tkmx-w{max-height:640px;overflow:auto}
.paper .tkmx{min-width:0;font-size:9px}.paper .tkmx td{height:auto;padding:2px}.paper .tkchip{font-size:8.5px;padding:1px 3px}
.tbE th,.tbE td{text-align:center;border:1px solid var(--line);padding:7px 8px;font-variant-numeric:tabular-nums}
.tbE th{vertical-align:middle;color:var(--ink-2);background:var(--surface-2)}
.tbE .l{text-align:left;font-weight:600;white-space:nowrap}
.tbE .jum{background:var(--accent-soft);font-weight:700}
.tbE th.sm{font-size:9.5px;letter-spacing:.2px;padding:5px 4px;line-height:1.2}
.tbE .ag{background:var(--good-soft);font-weight:600}
.tbE tr.subt td{background:var(--surface-2);font-weight:700}
.tbE tr.tot td{font-weight:800}
.meter{display:flex;align-items:center;gap:8px}
.meter .b{flex:1;height:7px;background:var(--surface-2);border-radius:4px;overflow:hidden;min-width:50px}
.meter .b i{display:block;height:100%;border-radius:4px}
.av{width:32px;height:32px;border-radius:50%;display:inline-grid;place-items:center;font-size:11px;font-weight:600;color:#fff;flex:none;object-fit:cover;vertical-align:middle;background:#5b6b93}
.nm{display:flex;align-items:center;gap:10px}
.nm small{display:block;color:var(--muted);font-size:11px}
.mono{font-family:var(--f-mono);font-size:12px}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.in{border:1px solid var(--line);background:var(--surface);border-radius:9px;padding:7px 10px;min-width:0;max-width:100%}
.in:focus{border-color:var(--accent);outline:none}
textarea.in{width:100%;min-height:90px;resize:vertical}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:9px;padding:7px 13px;font-weight:600;font-size:12.5px;display:inline-flex;gap:7px;align-items:center;white-space:nowrap}
.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn.pri{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.pri:hover{filter:brightness(1.08);color:#fff}
.btn.danger{color:var(--bad)}.btn.danger:hover{border-color:var(--bad)}
.btn.sm{padding:4px 9px;font-size:11.5px}
.btn:disabled{opacity:.5;cursor:not-allowed}
.form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.form .full{grid-column:1/-1}
.form label{display:flex;flex-direction:column;gap:5px;font-size:12px;font-weight:600;color:var(--ink-2);min-width:0}
.form label .in{font-weight:400;width:100%}
@media (max-width:640px){.form{grid-template-columns:1fr}}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;flex-wrap:wrap}
.seg button{border:0;background:var(--surface);padding:7px 12px;font-weight:500;font-size:12.5px;color:var(--ink-2)}
.seg button.on{background:var(--accent);color:#fff}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:14px;overflow-x:auto}
.tabs button{border:0;background:none;padding:9px 12px;font-weight:500;color:var(--muted);border-bottom:2px solid transparent;white-space:nowrap}
.tabs button.on{color:var(--accent);border-color:var(--accent)}
.note{font-size:12px;color:var(--ink-2);background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:10px 12px;line-height:1.6}
.note.warn{background:var(--warn-soft);border-color:transparent;color:var(--ink)}
.empty{text-align:center;color:var(--muted);padding:28px 12px;font-size:12.5px}
.ev{display:flex;gap:12px;padding:9px 0;border-bottom:1px dashed var(--line)}
.ev:last-child{border-bottom:0}
.ev .dt{width:46px;flex:none;text-align:center;border-radius:9px;background:var(--accent-soft);color:var(--accent);padding:4px 0;line-height:1.15}
.ev .dt b{display:block;font-size:16px}.ev .dt span{font-size:10px;font-weight:600;text-transform:uppercase}
.ev .tx{min-width:0;font-size:12.5px}.ev .tx small{display:block;color:var(--muted);font-size:11px}
.cardlist{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
.ccard{display:flex;flex-direction:column;gap:8px;text-align:left;border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:12px;min-width:0}
button.ccard:hover{border-color:var(--accent)}
.thumb{aspect-ratio:16/9;border-radius:8px;max-width:100%;width:100%;object-fit:cover;background:linear-gradient(135deg,var(--accent),var(--navy-2));display:grid;place-items:center;color:#fff;font-size:11px;font-weight:600}
.gb{display:flex;gap:18px;align-items:flex-start}
.gb .ph-gb{width:120px;height:120px;border-radius:50%;object-fit:cover;flex:none;border:4px solid var(--surface);box-shadow:0 4px 16px rgba(16,26,51,.15);background:var(--surface-2);display:grid;place-items:center;color:var(--muted)}
@media (max-width:640px){.gb{flex-direction:column;align-items:center;text-align:center}}
.yt{aspect-ratio:16/9;width:100%;border:0;border-radius:10px;max-width:100%}
/* Kalendar */
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border:1px solid var(--line);border-radius:12px;overflow:hidden}
.cal .h{background:var(--surface-2);font-size:11px;font-weight:600;color:var(--muted);text-align:center;padding:6px}
.cal .d{min-height:96px;border-top:1px solid var(--line);border-left:1px solid var(--line);padding:5px;display:flex;flex-direction:column;gap:3px;cursor:pointer;min-width:0;background:var(--surface)}
.cal .d:nth-child(7n+1){border-left:0}
.cal .d.out{background:var(--surface-2);opacity:.55}
.cal .d.today .n{background:var(--accent);color:#fff}
.cal .d:hover{background:var(--accent-soft)}
.cal .n{font-size:11px;font-weight:600;width:22px;height:22px;border-radius:50%;display:grid;place-items:center}
.cal .e{font-size:10.5px;border-radius:5px;padding:2px 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:var(--accent-soft);color:var(--accent);font-weight:500}
