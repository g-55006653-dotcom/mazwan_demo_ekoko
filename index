    const lj0 = $$('[data-cl]:checked', dlg).map(c => c.dataset.cl); ST.mLajur = lj0;
    const g = dlg.querySelector('#cmG').value, lj = lj0.filter(k => k !== g), sus = dlg.querySelector('#cmS').value, pb = dlg.querySelector('#cmPb').checked, rk = dlg.querySelector('#cmR').checked, ttd = dlg.querySelector('#cmTtd').checked, tajuk = dlg.querySelector('#cmT').value.trim() || 'SENARAI MURID';
    const lb = Object.fromEntries(LAJUR), J = x => jantinaP(x.jantina) ? 'P' : 'L';
    const val = (x, k) => k === '_catatan' || k === '_ttd' ? '' : k === 'jantina' ? J(x) : k === 'tahun' ? tahunLabel(x.tahun) : String(x[k] == null || x[k] === '-' ? '' : x[k]);
    const kunci = { kelas: x => String(x.kelas), nama: () => '', jantina: J };
    const ys = xs.slice().sort((a, b) => String((kunci[sus] || (x => val(x, sus) || '~'))(a)).localeCompare(String((kunci[sus] || (x => val(x, sus) || '~'))(b))) || (sus === 'nama' ? 0 : String(a.kelas).localeCompare(b.kelas)) || a.nama.localeCompare(b.nama));
