function huraiCsv(teks) {
  teks = String(teks || '').replace(/^﻿/, '').trim(); if (!teks) throw new Error('Tampal data atau pilih fail .csv terlebih dahulu.');
  const b1 = teks.split(/\r?\n/)[0], sep = b1.includes('\t') ? '\t' : b1.includes(';') && !b1.includes(',') ? ';' : ',';
  const rows = []; let row = [], cell = '', q = false;
  for (let i = 0; i < teks.length; i++) { const c = teks[i];
    if (q) { if (c === '"') { if (teks[i + 1] === '"') { cell += '"'; i++; } else q = false; } else cell += c; continue; }
    if (c === '"' && cell === '') q = true; else if (c === sep) { row.push(cell); cell = ''; } else if (c === '\n' || c === '\r') { if (c === '\r' && teks[i + 1] === '\n') i++; row.push(cell); rows.push(row); row = []; cell = ''; } else cell += c; }
  row.push(cell); rows.push(row);
  return rows;
}
