      rows.map((x, i) => [i + 1, esc(x.nama), ...lj.map(k => k[0] === '_' ? '<span style="display:inline-block;min-width:' + (k === '_ttd' ? 90 : 120) + 'px">&nbsp;</span>' : NW.includes(k) ? '<span class="nw">' + (esc(val(x, k)) || '–') + '</span>' : esc(val(x, k)) || '–')]), 'Tiada murid.');
