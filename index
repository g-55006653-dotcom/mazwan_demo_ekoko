      s += last ? `<path d="M${x},${y1 + hh} V${y1 + Math.min(4, hh)} q0,-4 4,-4 H${x + bw - 4} q4,0 4,4 V${y1 + hh}Z" fill="${sr.color}"/>` : `<rect x="${x}" y="${y1}" width="${bw}" height="${hh}" fill="${sr.color}"/>`; acc += v; });
    s += `<text class="lab num" x="${x + bw / 2}" y="${y(tot[i]) - 6}" text-anchor="middle">${tot[i]}</text><text x="${x + bw / 2}" y="${h - 8}" text-anchor="middle">${esc(c)}</text><rect data-i="${i}" x="${m.l + step * i}" y="${m.t}" width="${step}" height="${ih}" fill="transparent"/>`;
  });
  el.innerHTML = s + '</svg>';
  $$('rect[data-i]', el).forEach(r => { r.onmousemove = e => { const i = +r.dataset.i; showTip(`<b>${esc(cats[i])}</b><br>${series.map(sr => `${esc(sr.name)}: <b class="num">${sr.vals[i]}</b>`).join('<br>')}${series.length > 1 ? `<br>Jumlah: <b class="num">${tot[i]}</b>` : ''}`, e); }; r.onmouseleave = hideTip; });
}

