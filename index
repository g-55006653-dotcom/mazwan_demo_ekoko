/* ---------- tandatangan digital (PNG lutsinar) ---------- */
// Latar putih/kelabu cerah dibuang supaya tandatangan boleh diletak di atas cop
function prosesTtd(file, buangLatar = true, max = 700) {
  return new Promise((res, rej) => {
    if (!file || String(file.type).indexOf('image/') !== 0) return rej(new Error('Sila pilih fail gambar (PNG atau JPG).'));
    const r = new FileReader(); r.onerror = () => rej(new Error('Gambar tidak dapat dibaca.'));
    r.onload = () => { const img = new Image(); img.onload = () => {
      const k = Math.min(1, max / Math.max(img.width, img.height)), c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
      const g = c.getContext('2d'); g.drawImage(img, 0, 0, c.width, c.height);
      if (buangLatar) { const d = g.getImageData(0, 0, c.width, c.height), a = d.data; for (let i = 0; i < a.length; i += 4) { const l = (a[i] + a[i + 1] + a[i + 2]) / 3; if (l > 205) a[i + 3] = 0; else if (l > 150) a[i + 3] = Math.round(a[i + 3] * (205 - l) / 55); } g.putImageData(d, 0, 0); }
      res(c.toDataURL('image/png')); }; img.onerror = () => rej(new Error('Format gambar tidak disokong.')); img.src = r.result; };
    r.readAsDataURL(file);
  });
}
