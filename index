      if (adaPilihan && !ubah) {
        box.innerHTML = kad + `<div class="ag-siap"><div class="ag-siap-h">${ico('check')}<div><b>${esc(d.notaSiap || 'Pendaftaran Koko anda telah direkodkan. Harap Maklum.')}</b><small>Tarikh pilihan: ${d.masa ? esc(fmtDL(d.masa)) + ', ' + esc(String(d.masa).slice(11, 16)) : '–'}${d.sumber && d.sumber !== 'Ibu bapa' ? ' · diagihkan oleh sekolah (' + esc(d.sumber) + ')' : ''}</small></div></div>
          <table class="ag-siap-t"><tbody>${I.label.map(({ k, label }) => `<tr><td>${esc(label)}</td><td><b>${esc(d.pilihan[k] || '–')}</b></td></tr>`).join('')}</tbody></table></div>
          ${d.boleh ? `<button class="btn" id="agUbah" style="width:100%;margin-top:12px">${ico('edit')}Ubah pilihan</button><small class="sub" style="display:block;margin-top:6px">Pilihan boleh diubah sehingga disahkan oleh pihak sekolah.</small>` : `<div class="note" style="margin-top:12px">${d.status === 'Disahkan' ? 'Agihan murid ini telah <b>disahkan</b> dan dimasukkan ke rekod sekolah.' : 'Tempoh pilihan telah ditutup.'}</div>`}`;
        const ub = $('#agUbah'); if (ub) ub.onclick = () => { ubah = true; draw(); }; return;
      }
      box.innerHTML = kad + `
