    ok.disabled = true;
    try {
      const L = d.querySelector('#ubxL'), r = await act(() => call('unitUrusPadam', { kat: cat.kat, unit: u.unit, sah: sah.value, pindahKe: pin.value, ajkLama: !!(L && L.checked) }));
      toast(`Unit ${u.unit} dibuang: ${r.murid} murid ${pin.value ? 'dipindahkan' : 'dikosongkan'}, ${r.guru} guru dikemas kini, ${r.ajk} rekod AJK dipadam.`);
      ST.murid = ST.guru = ST.kokoUnitCache = null; closeModal(); reload();
    } catch (e) { ok.disabled = false; }
  };
}

</script>
