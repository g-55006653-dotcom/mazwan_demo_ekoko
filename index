    const I = await call('agihanInfo'), pil = Object.assign({}, d.pilihan), adaPilihan = I.label.some(({ k }) => d.pilihan[k]);
    let ubah = !adaPilihan;
    const draw = () => {
      const kad = `<div class="slip-hasil" style="margin-top:0"><div><small>Nama murid</small><b>${esc(d.nama)}</b></div><div><small>Kelas</small><b>${esc(d.kelas)}${d.sesi ? ' · Sesi ' + esc(d.sesi) : ''}</b></div><div><small>Status</small><b>${d.status === 'Disahkan' ? 'Disahkan sekolah' : d.status ? 'Pilihan disimpan' : 'Belum memilih'}</b></div></div>`;
