  for (let n = 1; n <= doc.numPages; n++) {
    const tc = await (await doc.getPage(n)).getTextContent(), items = tc.items.filter(i => String(i.str).trim()).map(i => ({ s: String(i.str).trim(), x: Math.round(i.transform[4]), y: Math.round(i.transform[5]) }));
    const lines = []; items.forEach(i => { let l = lines.find(l2 => Math.abs(l2.y - i.y) <= 3); if (!l) lines.push(l = { y: i.y, items: [] }); l.items.push(i); });
    lines.forEach(l => { l.items.sort((a, b) => a.x - b.x); l.text = l.items.map(i => i.s).join(' ').replace(/\s+/g, ' ').trim(); }); lines.sort((a, b) => b.y - a.y);
    pages.push(lines.map(l => l.text)); if (onProg) onProg(n, doc.numPages);
  }
