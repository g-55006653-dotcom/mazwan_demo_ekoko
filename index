function unitBorang(cats, kat, u) {
  const baru = !u, c = cats.find(x => x.kat === kat);
  const d = openModal(`<h2>${baru ? 'Tambah unit koko' : 'Edit unit · ' + esc(u.unit)}</h2>
    <div class="form">
      <label class="full">Kategori${baru ? sel('ubK', cats.map(x => [x.kat, katNama(x.label)]), kat) : `<input class="in" value="${esc(katNama(c.label))}" disabled>`}</label>
      <label class="full">Nama unit<input class="in" id="ubN" value="${esc(u ? u.unit : '')}" placeholder="Contoh: KADET REMAJA SEKOLAH" style="text-transform:uppercase"></label>
      <label class="full">Catatan (pilihan)<input class="in" id="ubC" value="${esc(u ? u.catatan : '')}" placeholder="Contoh: hari Rabu, 2.30 petang, Dataran"></label>
      ${baru ? `<label class="full">Guru penasihat (pilihan, satu nama setiap baris)<textarea class="in" id="ubP" rows="3" placeholder="Atau tetapkan pada lajur koko guru di Pengguna &amp; Peranan"></textarea></label>` : ''}
    </div>
    ${baru ? '' : `<div class="note" id="ubKesan" style="margin-top:10px">Jika nama ditukar, nama baharu dikemas kini secara automatik pada:<ul style="margin:6px 0 0 18px"><li><b>${u.ahliSemua}</b> murid dalam Data Murid</li><li><b>${u.guru.length}</b> guru (lajur koko ${esc(katNama(c.label))})</li><li><b>${u.ajk + u.penasihat + u.ajkLama}</b> rekod carta AJK / penasihat</li>${u.agihan ? '<li>Kuota &amp; pilihan Agihan Koko</li>' : ''}</ul>
      <label style="display:flex;gap:8px;align-items:center;margin-top:8px"><input type="checkbox" id="ubS" checked> Kemas kini juga rekod lama (${u.hadir} kehadiran, ${u.laporan} laporan, enrolmen &amp; arkib sesi)</label></div>`}
    <div class="foot"><button class="btn" id="ubNo">Batal</button><button class="btn pri" id="ubOk">${ico('ok')}Simpan</button></div>`);
  d.querySelector('#ubNo').onclick = closeModal;
  d.querySelector('#ubOk').onclick = async () => {
    const nama = d.querySelector('#ubN').value.trim().toUpperCase(); if (!nama) return toast('Sila isi nama unit.', true);
    const k = baru ? d.querySelector('#ubK').value : kat, b = d.querySelector('#ubOk'); b.disabled = true;
    try {
      const r = await act(() => call('unitUrusSimpan', { kat: k, lama: u ? u.unit : '', unit: nama, catatan: d.querySelector('#ubC').value, sejarah: baru ? true : d.querySelector('#ubS').checked, penasihat: baru ? d.querySelector('#ubP').value.split('\n') : [] }));
      toast(baru ? `Unit ${r.unit} ditambah.` : (r.murid || r.guru || r.ajk) ? `Unit dinamakan semula: ${r.murid} murid, ${r.guru} guru, ${r.ajk} rekod AJK dikemas kini.` : 'Unit dikemas kini.');
      ST.murid = ST.guru = ST.kokoUnitCache = null; ST.uu.kat = k; closeModal(); reload();
    } catch (e) { b.disabled = false; }
  };
}

function unitBuang(cat, u) {
