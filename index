function bars(el, cats, series, h = 240) {
  if (!el) return;
  const W = el.clientWidth || 400, m = { t: 22, r: 8, b: 26, l: 34 }, iw = W - m.l - m.r, ih = h - m.t - m.b;
  const tot = cats.map((_, i) => series.reduce((s, x) => s + x.vals[i], 0)), mx0 = Math.max(1, ...tot);
