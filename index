/* ---------- Cetak senarai murid: pilih lajur (unit koko yang ditag), kumpulan, susunan ---------- */
function cetakMurid(xs, f, unitCols, ds) {
  if (!xs.length) return toast('Tiada murid untuk dicetak. Ubah tapisan dahulu.', true);
  const LAJUR = [['ic', 'No. Pengenalan'], ['kelas', 'Kelas'], ['tahun', istilahTahun()], ['jantina', 'Jantina'], ...(ds ? [['sesiSekolah', 'Sesi']] : []), ...unitCols, ['status', 'Status'], ['_catatan', 'Lajur kosong (catatan)'], ['_ttd', 'Lajur kosong (tandatangan)']];
  const pilih = ST.mLajur = ST.mLajur || ['kelas', 'jantina', ...unitCols.map(c => c[0])];
  const nmKat = Object.fromEntries(unitCols), ringkas = [];
  if (f.kelas) ringkas.push('KELAS ' + f.kelas); if (f.tahun) ringkas.push(tahunLabel(f.tahun)); if (f.jantina) ringkas.push(f.jantina === 'P' ? 'PEREMPUAN' : 'LELAKI'); if (f.sesi) ringkas.push(f.sesi === '__x' ? 'SESI BELUM DITAG' : 'SESI ' + f.sesi);
  unitCols.forEach(([k, l]) => { if (f[k]) ringkas.push(f[k] === '__x' ? 'TIADA ' + l : f[k]); });
  const dlg = openModal(`<h2>Cetak senarai murid</h2><div class="sub" style="margin-bottom:10px">${xs.length} murid mengikut tapisan semasa${ringkas.length ? ': ' + esc(ringkas.join(' · ')) : ''}</div>
    <div class="form" style="grid-template-columns:1fr 1fr">
      <label class="full">Tajuk cetakan<input class="in" id="cmT" value="${esc(('SENARAI MURID' + (ringkas.length ? ' ' + ringkas.join(' · ') : '')).toUpperCase())}"></label>
      <label>Kumpulkan ikut${sel('cmG', [['', 'Tiada (satu senarai)'], ['kelas', 'Kelas'], ['tahun', istilahTahun()], ...unitCols, ...(ds ? [['sesiSekolah', 'Sesi']] : [])], '')}</label>
      <label>Susun ikut${sel('cmS', [['kelas', 'Kelas, kemudian nama'], ['nama', 'Nama'], ['jantina', 'Jantina, kemudian nama'], ...unitCols.map(([k, l]) => [k, l + ', kemudian nama'])], 'kelas')}</label>
      <div class="full"><b style="font-size:12.5px">Maklumat (lajur) dicetak</b> <small class="sub">· Bil. dan Nama sentiasa dicetak</small>
        <div class="checks" style="margin-top:6px">${LAJUR.map(([k, l]) => `<label><input type="checkbox" data-cl="${k}" ${pilih.includes(k) ? 'checked' : ''}>${esc(l)}</label>`).join('')}</div>
        <div style="display:flex;gap:6px;margin-top:6px;flex-wrap:wrap"><button class="btn sm" id="cmKoko">Unit koko sahaja</button><button class="btn sm" id="cmAsas">Maklumat asas sahaja</button><button class="btn sm" id="cmSemua">Semua</button></div></div>
      <label class="full" style="flex-direction:row;display:flex;gap:8px;align-items:center"><input type="checkbox" id="cmPb" style="width:18px;height:18px"> Mula halaman baharu bagi setiap kumpulan</label>
      <label class="full" style="flex-direction:row;display:flex;gap:8px;align-items:center"><input type="checkbox" id="cmR" checked style="width:18px;height:18px"> Sertakan ringkasan bilangan (L / P)</label>
      <label class="full" style="flex-direction:row;display:flex;gap:8px;align-items:center"><input type="checkbox" id="cmTtd" style="width:18px;height:18px"> Sertakan ruang tandatangan</label>
    </div>
    <div class="foot"><button class="btn" id="cmNo">Batal</button><button class="btn pri" id="cmOk">${ico('print')}Cetak</button></div>`, true);
  const tanda = ks => $$('[data-cl]', dlg).forEach(c => c.checked = ks.includes(c.dataset.cl));
  dlg.querySelector('#cmKoko').onclick = () => tanda(['kelas', ...unitCols.map(c => c[0])]);
  dlg.querySelector('#cmAsas').onclick = () => tanda(['ic', 'kelas', 'jantina', ...(ds ? ['sesiSekolah'] : [])]);
