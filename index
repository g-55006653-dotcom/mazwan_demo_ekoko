    const ic = inp.value.replace(/\D/g, ''); if (ic.length !== 12) return toast('Sila masukkan No. MyKad lengkap 12 digit.', true);
    const out = $('#slOut'), b = $('#slGo'); b.disabled = true; out.hidden = false; out.innerHTML = loadingHTML;
    try { const r = await call('slipCari', { ic }); await paparSlip(r, out); } catch (e) { out.innerHTML = `<div class="empty" style="color:var(--bad)">${esc(e.message || e)}</div>`; }
