async function paparSlip(r, box) {
  box.innerHTML = loadingHTML;
  let imgs = [];
  try { imgs = await pdfKeGambar(b64ToBytes(r.data), 2); } catch (e) { box.innerHTML = `<div class="empty">Slip tidak dapat dipaparkan: ${esc(e.message || e)}</div>`; return; }
  box.innerHTML = `<div class="slip-hasil"><div><small>Nama murid</small><b>${esc(r.nama)}</b></div><div><small>Kelas</small><b>${esc(r.kelas)}</b></div><div><small>Tahun</small><b>${esc(r.tahun)}</b></div><div><small>Sesi</small><b>${esc(r.sesi)}</b></div>${r.gred ? `<div><small>10% / Gred</small><b>${esc(r.markah || '')}${r.markah ? ' / ' : ''}${esc(r.gred)}</b></div>` : ''}</div>
    <div class="tools" style="justify-content:center;margin-bottom:12px"><button class="btn pri" id="slCet">${ico('print')}Cetak slip (A4 landskap)</button><button class="btn" id="slDl">${ico('download')}Muat turun PDF</button></div>
    <div class="slip-pv">${imgs.map((u, i) => `<img src="${u}" alt="Slip PAJSK ${esc(r.nama)} halaman ${i + 1}">`).join('')}</div>`;
  box.querySelector('#slCet').onclick = () => showPrint(imgs.map((u, i) => `<img src="${u}" alt="Halaman ${i + 1}">`).join(''), 'slip');
  box.querySelector('#slDl').onclick = () => { try { const bl = new Blob([b64ToBytes(r.data)], { type: 'application/pdf' }), a = document.createElement('a'); a.href = URL.createObjectURL(bl); a.download = `SLIP PAJSK ${r.nama} ${String(r.sesi).replace(/[^\w-]/g, '-')}.pdf`; document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 4000); } catch (e) { toast('Muat turun disekat oleh pelayar. Gunakan Cetak › Simpan sebagai PDF.', true); } };
}
PAGES.carianSlip = async m => {
  const s = ST.boot.settings, buka = String(s.slipAktif) === '1';
  m.innerHTML = head('Carian Slip PAJSK', 'Pentaksiran Aktiviti Jasmani, Sukan dan Kokurikulum · untuk ibu bapa dan murid') + `<div class="card cari-hero"><div class="ikon">${ico('slip')}</div><h2 style="margin:0 0 6px">Semak & cetak Slip PAJSK</h2><p class="sub" style="margin:0;line-height:1.6">${esc(s.slipNota)}</p>
