const normT = h => String(h || '').toUpperCase().split('*').join('').replace(/\(.*?\)/g, '').replace(/[^A-Z0-9]/g, '');
const MURID_TAJUK = (() => { const m = {}, add = (f, ...hs) => hs.forEach(h => m[normT(h)] = f);
