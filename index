<script>
/* HalamanAgihan.html — Agihan koko murid baharu (Tahun 4 / Tingkatan 1): pilihan ibu bapa ikut kuota, agihan automatik, pengesahan admin */
/* Nota: jangan tulis dua garis miring berturut-turut di luar komen; Apps Script membuangnya. */

const AG_LANGKAH = [['Tutup', 'Tetapan'], ['Cadangan', 'Cadangan kuota'], ['Dibuka', 'Dibuka kepada ibu bapa'], ['Ditutup', 'Pilihan ditutup'], ['Selesai', 'Disahkan ke Data Murid']];
const agFlow = st => { const i = AG_LANGKAH.findIndex(x => x[0] === st); return `<div class="ag-flow">${AG_LANGKAH.map(([k, l], j) => `<span class="${j === i ? 'on' : j < i ? 'lepas' : ''}">${j + 1}. ${l}</span>`).join('<span style="background:none;padding:0">›</span>')}</div>`; };
// Kad kuota unit: baris berasingan bagi lelaki dan perempuan
const agBaris = (lbl, d, q, b) => { if (!q) return `<div class="ag-j tiada"><span>${lbl}</span><small>tiada tempat</small></div>`;
  const pct = Math.min(100, Math.round(d / q * 100)), cls = b <= 0 ? 'penuh' : b <= Math.max(1, q * .15) ? 'hampir' : '';
  return `<div class="ag-j ${cls}"><span>${lbl}</span><div class="bar"><i style="width:${pct}%"></i></div><small class="num">${d}/${q}</small>${b <= 0 ? chip('PENUH', 'bad') : chip('Baki ' + b, cls ? 'warn' : 'good')}</div>`; };
const agKad = u => `<div class="ag-u ${u.baki <= 0 ? 'penuh' : ''}"><div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start"><b style="font-size:13px">${esc(u.unit)}</b><small class="sub num">${u.diisi}/${u.kuota}</small></div>
  ${agBaris('Lelaki', u.diisiL, u.kuotaL, u.bakiL)}${agBaris('Perempuan', u.diisiP, u.kuotaP, u.bakiP)}</div>`;
function agKuotaHTML(info) {
  return info.label.map(({ k, label }) => { const us = info.units.filter(u => u.kat === k); const bL = us.reduce((a, u) => a + u.bakiL, 0), bP = us.reduce((a, u) => a + u.bakiP, 0);
    return `<div style="margin-bottom:14px"><div class="ch" style="margin-bottom:8px"><h3>${esc(label)}</h3><div class="sp"></div><span class="sub">${us.length} unit · baki lelaki ${bL} · perempuan ${bP}</span></div><div class="ag-q">${us.map(agKad).join('') || '<div class="empty">Tiada unit ditawarkan.</div>'}</div></div>`; }).join('');
}
PAGES.agihan = async m => {
  const admin = lv() >= 3, f = ST.ag = ST.ag || { tab: 'pilih', ic: '' };
  if (!admin) f.tab = 'pilih';
  const info = await call('agihanInfo'), buka = info.status === 'Dibuka';
  m.innerHTML = head('Agihan Koko Murid Baharu', `Pilihan unit kokurikulum bagi murid ${esc(tahunLabel(info.tahun))} · kuota terhad mengikut unit`)
    + (admin ? `<div class="tabs"><button data-t="pilih" class="${f.tab === 'pilih' ? 'on' : ''}">Pilihan ibu bapa</button><button data-t="urus" class="${f.tab === 'urus' ? 'on' : ''}">Urus agihan (admin)</button></div>` : '') + '<div id="agB"></div>';
  $$('.tabs [data-t]', m).forEach(b => b.onclick = () => { f.tab = b.dataset.t; reload(); });
  const B = $('#agB');
  if (f.tab === 'urus') return agUrus(B);
  if (!/Dibuka|Ditutup|Selesai/.test(info.status)) { B.innerHTML = `<div class="card cari-hero"><div class="ikon">${ico('layers')}</div><h2 style="margin:0 0 6px">Agihan koko belum dibuka</h2><p class="sub" style="margin:0;line-height:1.6">Pihak sekolah sedang menyediakan kuota unit kokurikulum bagi murid ${esc(tahunLabel(info.tahun))}. Sila semak semula kemudian.</p>${admin ? '<div class="note" style="margin-top:12px">Admin: buka tab <b>Urus agihan</b> untuk menjana cadangan kuota dan membuka pilihan.</div>' : ''}</div>`; return; }
  B.innerHTML = `<div class="grid"><div class="card c5" style="align-self:start"><h3>${buka ? 'Buat pilihan unit koko' : 'Semak keputusan agihan'}</h3><p class="sub" style="line-height:1.6;margin:6px 0 10px">${esc(info.nota)}${info.tutup ? ` <b>Tarikh tutup: ${fmtD(info.tutup)}.</b>` : ''}</p>
      <div class="cari-row" style="margin-top:0"><input class="in" id="agIc" inputmode="numeric" maxlength="14" placeholder="No. MyKad murid" value="${esc(f.ic)}" aria-label="No. MyKad murid"><button class="btn pri" id="agGo">${ico('search')}Semak</button></div>
      <div id="agMurid" style="margin-top:14px"></div></div>
    <div class="card c7"><div class="ch"><div><h3>Kuota & baki tempat</h3><div class="sub">${info.memilih} daripada ${info.sasaran} murid telah membuat pilihan · dikemas kini setiap kali pilihan disimpan</div></div><div class="sp"></div>${chip(buka ? 'DIBUKA' : info.status === 'Selesai' ? 'SELESAI' : 'DITUTUP', buka ? 'good' : 'warn')}</div><div id="agQ">${agKuotaHTML(info)}</div></div></div>`;
  const inp = $('#agIc'); inp.oninput = () => { inp.value = inp.value.replace(/[^\d-]/g, ''); };
  const semak = async () => {
    const ic = inp.value.replace(/\D/g, ''); if (ic.length !== 12) return toast('Sila masukkan No. MyKad lengkap 12 digit.', true); f.ic = ic;
    const box = $('#agMurid'); box.innerHTML = loadingHTML;
