    <small style="display:block;margin-top:10px;color:var(--muted)">No. MyKad hanya digunakan untuk mencari slip dan tidak disimpan.</small></div><div class="card" id="slOut" hidden style="margin-top:16px"></div>`;
  const inp = $('#slIc'); if (!inp) return;
  inp.oninput = () => { inp.value = inp.value.replace(/[^\d-]/g, ''); };
