/* ---------- Pengesahan laporan oleh GPK Kokurikulum (loceng) ---------- */
async function sahkanModal(rows, tindakan = 'sah') {
  rows = rows.filter(Boolean); if (!rows.length) return toast('Tiada laporan dipilih.', true);
  const r0 = await act(() => call('ttdSaya')), ttd = r0.foto ? await imgSrc(r0.foto) : '';
  if (tindakan === 'sah' && !ttd) { if (await confirmBox('Anda belum memuat naik tandatangan digital. Muat naik sekarang?', 'Muat naik tandatangan')) ttdModal(); return; }
  const kembali = tindakan === 'kembali';
  const d = openModal(`<h2>${kembali ? 'Kembalikan laporan untuk pembetulan' : 'Sahkan laporan kokurikulum'}</h2>
    <div class="note" style="margin-bottom:12px">${rows.length === 1 ? `<b>${esc(rows[0].tajuk)}</b><br><small>${esc(rows[0].unit)} · ${fmtD(rows[0].tarikh)} · disediakan oleh ${esc(rows[0].disediakan)}</small>` : `<b>${rows.length} laporan</b> dipilih: ${rows.slice(0, 5).map(r => esc(r.unit)).join(', ')}${rows.length > 5 ? '…' : ''}`}</div>
    <div class="form"><label>Tarikh ${kembali ? '' : 'pengesahan (dicetak pada cop)'}<input class="in" type="date" id="shT" value="${today()}"></label><label class="full">${kembali ? 'Sebab / pembetulan yang diperlukan *' : 'Catatan (pilihan)'}<textarea class="in" id="shC" placeholder="${kembali ? 'Contoh: Sila lengkapkan objektif dan lampirkan gambar aktiviti.' : ''}"></textarea></label></div>
    ${kembali ? '' : `<div style="margin-top:12px"><div class="sub" style="margin-bottom:6px">Pratonton cop & tandatangan pada laporan:</div><div class="cop-pv"><div class="sahb">Disahkan oleh,<div class="sah-ttd" id="shPv"><img class="ttd" src="${ttd}" alt="Tandatangan">${copSVG(today(), 112)}</div><div class="ln" style="border-top:1px solid #14213d;padding-top:4px;font-weight:700;min-width:180px">${esc(String(ST.user.nama).toUpperCase())}</div><small>${esc(ST.boot.settings.gpkJawatan)}</small></div><button class="btn sm" id="shTtd" style="color:var(--ink)">${ico('sign')}Tukar tandatangan</button></div></div>`}
    <div class="foot"><button class="btn" id="shNo">Batal</button><button class="btn ${kembali ? 'danger' : 'pri'}" id="shOk">${ico(kembali ? 'left' : 'stamp')}${kembali ? 'Kembalikan' : rows.length > 1 ? `Sahkan ${rows.length} laporan` : 'Sahkan & cop'}</button></div>`);
  const t = d.querySelector('#shT'); if (!kembali) t.onchange = () => { const pv = d.querySelector('#shPv'); pv.querySelector('svg').outerHTML = copSVG(t.value, 112); };
  const tt = d.querySelector('#shTtd'); if (tt) tt.onclick = () => { closeModal(); ttdModal(); };
  d.querySelector('#shNo').onclick = closeModal;
  d.querySelector('#shOk').onclick = async () => {
    const c = d.querySelector('#shC').value.trim(); if (kembali && !c) return toast('Sila nyatakan sebab laporan dikembalikan.', true);
    const b = d.querySelector('#shOk'); b.disabled = true;
    try { const n = await act(() => call('sahkan', { ids: rows.map(r => r.id), tarikh: t.value, catatan: c, tindakan })); toast(kembali ? `${n} laporan dikembalikan kepada guru.` : `${n} laporan disahkan dengan cop dan tandatangan digital.`); closeModal(); await refreshBoot(); renderNav(); reload(); } catch (e) { b.disabled = false; }
  };
}
