async function xlsxLib() { if (window.XLSX) return window.XLSX; await muatSkrip(CDN + 'xlsx/0.18.5/xlsx.full.min.js'); return window.XLSX; }
// Jana fail .xlsx dalam pelayar: semua sel format teks supaya No. Pengenalan kekal 12 digit
async function muatTurunTemplat(jenis, isi) {
  const t = await act(() => call('templat', { jenis, isi })), X = await xlsxLib();
  const ws = X.utils.aoa_to_sheet([t.tajuk, ...t.rows]);
