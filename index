/* ---------- PDF: pdf.js (baca & papar) dan pdf-lib (pecah halaman) ---------- */
function muatSkrip(src) { return new Promise((res, rej) => { const s = document.createElement('script'); s.src = src; s.onload = res; s.onerror = () => rej(new Error('Pustaka PDF tidak dapat dimuatkan. Semak sambungan internet.')); document.head.appendChild(s); }); }
const CDN = 'https:' + '/' + '/cdnjs.cloudflare.com/ajax/libs/';
async function pdfJs() {
  if (window.pdfjsLib) return window.pdfjsLib;
  await muatSkrip(CDN + 'pdf.js/3.11.174/pdf.min.js'); window.pdfjsLib.GlobalWorkerOptions.workerSrc = CDN + 'pdf.js/3.11.174/pdf.worker.min.js'; return window.pdfjsLib;
}
async function pdfLibDoc() { if (window.PDFLib) return window.PDFLib; await muatSkrip(CDN + 'pdf-lib/1.17.1/pdf-lib.min.js'); return window.PDFLib; }
function b64ToBytes(b64) { const s = atob(String(b64).replace(/^data:[^,]*,/, '')), a = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) a[i] = s.charCodeAt(i); return a; }
function bytesToB64(u8) { let s = ''; for (let i = 0; i < u8.length; i += 0x8000) s += String.fromCharCode.apply(null, u8.subarray(i, i + 0x8000)); return btoa(s); }
// Papar setiap halaman PDF sebagai gambar (untuk pratonton & cetak landskap A4)
async function pdfKeGambar(bytes, skala = 2) {
  const lib = await pdfJs(), doc = await lib.getDocument({ data: bytes }).promise, out = [];
  for (let n = 1; n <= doc.numPages; n++) {
    const pg = await doc.getPage(n), vp = pg.getViewport({ scale: skala }), c = document.createElement('canvas'); c.width = Math.round(vp.width); c.height = Math.round(vp.height);
    const g = c.getContext('2d'); g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height); await pg.render({ canvasContext: g, viewport: vp }).promise; out.push(c.toDataURL('image/jpeg', .92));
  }
  return out;
}

